{
  "name": "@tks-ai/edu-upload-mcp",
  "version": "2.0.6",
  "description": "教学应用上传 MCP 桥接（stdio ⇄ 远程）：把本地 stdio 连接转发到 Java 后端的 MCP 端点，供 CodeBuddy / Trae / Codex 等使用",
  "type": "module",
  "bin": {
    "tks-ai-edu-upload-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bin": "npm run build && node build.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "bun": "^1.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
